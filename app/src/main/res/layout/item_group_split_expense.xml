<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_glass"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvPayerAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#DEF2EE"
        android:gravity="center"
        android:text="👤"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBillTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rental Car &amp; Fuel"
            android:textColor="@color/text_high_emphasis"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPaidBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paid by Alex • Split 3 ways"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBillAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹13,409 ($140)"
        android:textColor="@color/primary_cyan"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>